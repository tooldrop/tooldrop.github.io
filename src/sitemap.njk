---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://tooldrop.github.io/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://tooldrop.github.io/new-releases/</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://tooldrop.github.io/about/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  {% for cat in collections.categories %}
  <url>
    <loc>https://tooldrop.github.io/category/{{ cat.slug }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  {% for tool in collections.toolPages %}
  <url>
    <loc>https://tooldrop.github.io/tool/{{ tool.slug }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
</urlset>
